{
  "name": "codenames",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@codenames/server & npm run dev --workspace=@codenames/web",
    "dev:server": "npm run dev --workspace=@codenames/server",
    "dev:web": "npm run dev --workspace=@codenames/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "dictionary": "node scripts/build-dictionary.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
